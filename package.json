{
  "name": "ngo-crm-cloud",
  "version": "0.1.0",
  "releaseDate": "2026-11-15",
  "private": true,
  "description": "Lekki, modułowy CRM dla polskich NGO (wersja chmurowa, self-hosting)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "dev:account": "tsx --tsconfig tsconfig.server.json scripts/dev-account.ts",
    "dev:demo": "tsx --tsconfig tsconfig.server.json scripts/dev-demo.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.server.config.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "^10.1.11",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "lucide-react": "1.71.0",
    "mysql2": "^3.24.6",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
