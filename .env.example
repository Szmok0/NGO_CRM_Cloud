# Wzór pliku .env (lokalnie). Na serwerze te same zmienne ustawia się w panelu hostingu.
# Prawdziwych wartości nigdy nie zapisuj w repozytorium.

# Połączenie z bazą MySQL/MariaDB. Na Hostingerze host 127.0.0.1 (nie localhost).
DATABASE_URL=mysql://ngocrm:HASLO@127.0.0.1:3306/ngocrm

# Sekret serwera (min. 32 znaki, losowy). Szyfruje sekrety TOTP i podpisuje dane techniczne.
# Wygenerowanie: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Folder na załączniki i kopie, POZA folderem aplikacji (wdrożenie podmienia folder aplikacji).
STORAGE_DIR=./storage

# Jednorazowy token kreatora pierwszego uruchomienia. Usuń po założeniu administratora.
SETUP_TOKEN=

# Port serwera. Lokalnie 3001 (Vite na 5173 przekierowuje /api). Hosting zwykle ustawia go sam.
PORT=3001
