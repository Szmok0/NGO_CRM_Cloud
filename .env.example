# Wzór pliku .env (lokalnie). Na serwerze te same zmienne ustawia się w panelu hostingu
# (Hostinger podaje je procesowi bezpośrednio, bez pliku .env).
# Prawdziwych wartości nigdy nie zapisuj w repozytorium.
# Bez poprawnych DATABASE_URL i APP_SECRET serwer startuje w trybie kreatora:
# strona i /api/health pokazują, które zmienne ustawić.

# WYMAGANE. Połączenie z bazą MySQL/MariaDB: mysql://UŻYTKOWNIK:HASŁO@HOST:PORT/BAZA.
# Na Hostingerze host 127.0.0.1 (nie localhost, nie srvNNN.hstgr.io).
# Znaki specjalne w haśle (@ : / ? # % &) zakoduj jak w adresie URL, np. @ → %40; najprościej hasło z liter i cyfr.
# Lokalnie ta sama baza służy testom (npm test tworzy i usuwa tabelę test_records).
DATABASE_URL=mysql://ngocrm:HASLO@127.0.0.1:3306/ngocrm

# WYMAGANE. Sekret serwera, co najmniej 32 bajty, losowy. Szyfruje sekrety TOTP i podpisuje dane techniczne.
# Zmiana po założeniu kont unieważnia 2FA wszystkich użytkowników.
# Wygenerowanie: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Folder na załączniki i kopie, POZA folderem aplikacji (każde wdrożenie podmienia folder aplikacji).
# Lokalnie np. ./storage (w .gitignore). Na Hostingerze katalog domeny poza public_html, np.:
# STORAGE_DIR=/home/u161817445/domains/ivory-elk-740131.hostingersite.com/storage
# Kod jeszcze z niego nie korzysta; kreator (ZADANIE_01, krok 6) sprawdzi, czy da się w nim zapisać.
STORAGE_DIR=./storage

# Jednorazowy token kreatora pierwszego uruchomienia (długi, losowy). Usuń z panelu po założeniu administratora.
# Kod jeszcze z niego nie korzysta (kreator: ZADANIE_01, krok 6).
SETUP_TOKEN=

# Port serwera. Lokalnie 3001 (Vite na 5173 przekierowuje /api). Hosting podaje go sam (nie trzeba ustawiać).
PORT=3001
